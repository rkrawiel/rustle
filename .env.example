# Required. Postgres connection string. The role needs CREATEDB to run the test suite.
DATABASE_URL=postgres://rustle:rustle@localhost:5432/rustle

# Optional, with the defaults shown.
RUSTLE_LISTEN_ADDR=127.0.0.1:8080
RUSTLE_BASE_URL=http://localhost:8080
RUSTLE_POLL_INTERVAL_MINUTES=60
RUSTLE_LOG_LEVEL=info
RUSTLE_FETCH_CONCURRENCY=8
RUSTLE_SESSION_TTL_DAYS=30
RUSTLE_RETENTION_DAYS=0

# Leave unset in production: a one-time token is generated and printed to the logs on
# first start. Set it only to script an unattended first-run setup.
# RUSTLE_SETUP_TOKEN=

# Defaults to true when RUSTLE_BASE_URL is https, false otherwise. Browsers never send
# Secure cookies over plain http, so local development needs it off.
# RUSTLE_COOKIE_SECURE=false
